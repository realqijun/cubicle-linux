---
config:
  theme: base
  htmlLabels: false
  themeCSS: 'text { font-family: Arial, Helvetica, sans-serif !important; }'
  themeVariables:
    fontFamily: 'Arial, Helvetica, sans-serif'
    fontSize: 16px
    primaryColor: '#eef4f1'
    primaryTextColor: '#20332e'
    primaryBorderColor: '#5f8175'
    lineColor: '#627a72'
    clusterBkg: '#fafbf9'
    clusterBorder: '#bfcfc6'
    edgeLabelBackground: '#ffffff'
  flowchart:
    htmlLabels: false
    curve: basis
    nodeSpacing: 28
    rankSpacing: 45
---
flowchart TB
    cli["Operator CLI"]
    sourceProject["Original project"]
    supervisor["Trusted supervisor: policy, broker and model admission"]
    runner["Ubuntu offline runner"]
    launchGate["Live-project launch gate: blocked"]

    subgraph isolated ["Tested offline boundary: Bubblewrap + AppArmor + seccomp"]
        process["Command + descendants"]
        workspace["Private workspace / retained edits"]
    end

    subgraph connector ["Connector fixtures pass; full launcher pending"]
        opencode["OpenCode 2.2.5 + hook bridge + tools"]
    end

    subgraph storage ["Protected supervisor storage"]
        state[("Control records")]
        provenance[("Origins + project notes")]
    end

    provider["Configured model provider"]
    report["Offline provenance report"]

    cli -->|"Review and approve"| supervisor
    supervisor -->|"Approved grant; runner rechecks authority"| runner
    sourceProject -->|"Copy permitted inputs only"| runner
    runner -->|"Prepare private copy"| workspace
    runner -->|"Launch and contain"| process
    process -->|"Read and edit"| workspace
    supervisor -->|"Check full-runtime protection"| launchGate
    launchGate -.->|"Confinement + provider integration pending"| opencode
    opencode <-->|"Blocking hook admission"| supervisor
    opencode -->|"Native HTTP after admission"| provider
    supervisor -->|"Persist authority and decisions"| state
    supervisor -->|"Record origins"| provenance
    state -->|"Read-only export"| report
    provenance -->|"Read-only export"| report

    classDef pending fill:#fff5e5,stroke:#b07824,color:#694716,stroke-dasharray:6 4
    classDef output fill:#f1f3f8,stroke:#7c87a1,color:#29364c
    class launchGate pending
    class sourceProject,workspace,provider,report output
    style isolated fill:#f1f7f3,stroke:#5f8175
    style connector fill:#fffcf6,stroke:#b07824,stroke-dasharray:6 4
